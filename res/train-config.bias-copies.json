{
  "data": "train/sections.jsonl",
  "schema": "schema.example.json",
  "output": "../artifacts/lstm-bias-copies.pt",
  "device": "auto",
  "deterministic": true,
  "epochs": 20,
  "batch_size": 32,
  "hidden_size": 64,
  "num_layers": 1,
  "learning_rate": 0.001,
  "seed": 42,
  "augmentation_seed": 1000045,
  "augmentation": {
    "probability": 1.0,
    "augmented_copies": 4,
    "features": {
      "speed_kmh": {
        "bias_max": 0,
        "noise_max": 0.05,
        "smoothing": 0.1,
        "min": 0,
        "max": 120,
        "protected_values": [0, 1, 20],
        "fixed_values": [0]
      },
      "accel_mps2": {
        "bias_max": 0,
        "noise_max": 0.05,
        "smoothing": 0.2,
        "min": -500,
        "max": 500,
        "protected_values": [],
        "fixed_values": [0]
      },
      "yaw_rate_dps": {
        "bias_max": 0,
        "noise_max": 0.2,
        "smoothing": 0.2,
        "min": -180,
        "max": 180,
        "protected_values": [],
        "fixed_values": [0]
      },
      "steering_input": {
        "bias_max": 0.02,
        "noise_max": 0.01,
        "smoothing": 0.1,
        "min": -1,
        "max": 1,
        "protected_values": [],
        "fixed_values": [-1, 0, 1]
      },
      "throttle_input": {
        "bias_max": 0.02,
        "noise_max": 0.01,
        "smoothing": 0.1,
        "min": 0,
        "max": 1,
        "protected_values": [],
        "fixed_values": [0, 1]
      },
      "brake_input": {
        "bias_max": 0.02,
        "noise_max": 0.01,
        "smoothing": 0.1,
        "min": 0,
        "max": 1,
        "protected_values": [],
        "fixed_values": [0, 1]
      }
    }
  }
}
